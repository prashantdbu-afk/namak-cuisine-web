{
  "name": "namak-cuisine-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.16.0",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:performance": "node scripts/run-lighthouse.mjs",
    "report:analytics": "node scripts/generate-analytics-report.mjs weekly",
    "check:assets": "node scripts/check-assets.mjs",
    "prepare:food-media": "node scripts/prepare-food-media.mjs",
    "prepare:bar-media": "node scripts/prepare-bar-media.mjs",
    "prepare:venue-media": "node scripts/prepare-venue-media.mjs",
    "review:bar-shelf-edit": "node scripts/edit-bar-shelf-media.mjs",
    "review:venue-placements": "node scripts/create-venue-placement-contact-sheet.mjs"
  },
  "dependencies": {
    "@next/third-parties": "16.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.0",
    "jsdom": "28.1.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
